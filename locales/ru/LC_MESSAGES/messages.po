msgid "admin_unconfirmed"
msgstr "Запись #{id} ({client}, {date} {time}) не подтверждена. Свяжитесь с клиентом."

msgid "waitlist_freed"
msgstr "Освободилось место на {date} {time}! Занять?"

msgid "btn_confirm"
msgstr "Подтвердить"

msgid "btn_cancel"
msgstr "Отменить"

msgid "btn_back"
msgstr "Назад"

msgid "btn_main_menu"
msgstr "Главное меню"

msgid "btn_join_waitlist"
msgstr "Встать в очередь"

msgid "btn_leave_waitlist"
msgstr "Выйти из очереди"

msgid "btn_reschedule"
msgstr "Перенести"

msgid "btn_take_slot"
msgstr "Занять"

msgid "btn_decline_slot"
msgstr "Отказаться"
